# Where each variable goes is listed in docs/MISE_EN_PRODUCTION.md.
# On Vercel, NEXT_PUBLIC_* variables must be of type "Config" (they're
# public by design); everything else should be a "Secret".

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────
# Public origin used to build Stripe redirect URLs, auth email links and
# AI/webhook callbacks. Required for Trigger.dev tasks, which run outside
# any HTTP request and can't fall back to request headers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows "Continue with Google" on login/register once Google is enabled in
# Supabase (Authentication → Providers). Leave unset until then.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# ── Public identity (footer, /legal, /terms, /privacy) ─────
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
# Consumer mediator (mandatory for B2C sales in France): name + website.
NEXT_PUBLIC_LEGAL_MEDIATOR=

# ── AI providers ──────────────────────────────────────────
# "fal" (default) or "replicate"
AI_PROVIDER=fal
FAL_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
# Shared secret appended to the AI webhook callback URL so /api/webhooks/ai
# can reject forged requests before even checking the provider signature.
AI_WEBHOOK_SECRET=
# From `replicate.webhooks.default.secret.get()` — verifies the
# Webhook-Signature header on /api/webhooks/ai deliveries from Replicate.
REPLICATE_WEBHOOK_SECRET=
# ElevenLabs sound-generation API key, used for the optional "Add AI sound" step.
ELEVENLABS_API_KEY=

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDIT_PACK=
# "true" once Stripe Tax is activated in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=

# ── Upstash Redis (rate limiting) ──────────────────────────
# Optional in dev — requests are allowed through (fail-open) when unset.
# Required in production to protect the generation/upscale/audio/export
# endpoints from abuse.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Trigger.dev (background job queue) ─────────────────────
# Project ref from the Trigger.dev dashboard (or `npx trigger.dev@latest init`).
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
