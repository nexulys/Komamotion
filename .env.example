# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────
# Public origin used to build Stripe redirect URLs and AI webhook callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers ──────────────────────────────────────────
# "fal" or "replicate"
AI_PROVIDER=fal
FAL_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
# Shared secret appended to the AI webhook callback URL so /api/webhooks/ai
# can reject forged requests.
AI_WEBHOOK_SECRET=

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDIT_PACK=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
